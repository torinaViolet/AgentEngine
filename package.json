{
  "name": "@notic/agent-engine",
  "version": "3.0.1",
  "description": "A lightweight, elegant, and feature-complete TypeScript AI Agent framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "default": "./dist/generator/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./message": {
      "types": "./dist/message/index.d.ts",
      "default": "./dist/message/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "default": "./dist/legacy/index.js"
    },
    "./legacy/*": {
      "types": "./dist/legacy/*/index.d.ts",
      "default": "./dist/legacy/*/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "rimraf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js && npm run test:browser && npm run test:exports",
    "test:browser": "rimraf .browser-dist && esbuild ./test/browser-smoke.ts --bundle --platform=browser --format=esm --outfile=./.browser-dist/index.js && node test/browser-runtime.cjs",
    "test:exports": "npm run clean && npm run build && node test/package-exports.cjs",
    "test:real:deepseek": "rimraf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/agent/agent.real.test.js",
    "prepublishOnly": "npm test && npm run clean && npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "openai",
    "chatgpt",
    "gpt",
    "claude",
    "gemini",
    "deepseek",
    "mcp",
    "tool-calling",
    "streaming",
    "typescript",
    "framework"
  ],
  "author": "notic",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/torinaViolet/AgentEngine.git"
  },
  "homepage": "https://github.com/torinaViolet/AgentEngine#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "openai": "^6.34.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.3",
    "zod": "^4.3.6"
  }
}
